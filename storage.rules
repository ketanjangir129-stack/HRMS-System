rules_version = '2';

// Resume uploads (EmployeeService.uploadResume) live at
//   companies/{companyCode}/employees/{employeeId}/resume.pdf
//
// Storage rules cannot read the Realtime Database, so they cannot check the
// caller's company the way database.rules.json does. Sign-in is enforced here;
// tightening this to per-company access needs custom claims on the Auth token,
// which in turn needs the Admin SDK. See MIGRATION.md.
service firebase.storage {
  match /b/{bucket}/o {

    match /companies/{companyCode}/employees/{employeeId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
